# Bridge & Buy end-to-end checks only (scripts/e2e-bridge.mjs): a mainnet build whose NEARKITS server
# is a fake host the test answers for itself (api.bridge-e2e.test does not resolve), so nothing
# reaches NEAR Intents and no funds move. The test injects fake source wallets.
VITE_NEARKIT_SERVICES=near
VITE_NEAR_NETWORK=mainnet
VITE_ENABLE_MAINNET_EXECUTION=true
VITE_NEARKIT_FEE_RECIPIENT=nearkitfee.near
VITE_NEARKIT_API_URL=https://api.bridge-e2e.test
