# NearKit build configuration. Copy to .env.local and edit. No value here is secret.
# Every variable is read and validated once in src/config/env.ts; an invalid value
# stops the app with a configuration error instead of falling back silently.

# "near" (default) runs the real NEAR implementation.
# "demo" runs the Phase 1 simulator: demo data, nothing is signed or sent.
VITE_NEARKIT_SERVICES=near

# "testnet" (default) or "mainnet". Fixed for the life of a page; switch by rebuilding.
VITE_NEAR_NETWORK=testnet

# Optional RPC override, comma-separated, first = primary, rest = failover.
# Leave empty to use the network's verified defaults (FastNEAR, Intear, dRPC).
VITE_NEAR_RPC_URL=

# Value-moving actions on MAINNET run only when this is exactly "true".
# Keep it "false" until the testnet checklist in README.md has passed.
VITE_ENABLE_MAINNET_EXECUTION=false

# NEAR account that receives the NearKit 0.10% app fee on trades (public information).
# Required for fee-bearing mainnet trades; without it they are blocked, never re-routed.
# Must belong to the configured network (no ".testnet" account on mainnet).
VITE_NEARKIT_FEE_RECIPIENT=

# $KIT NEP-141 contract, once it has launched on Nearly. Leave empty until then:
# NearKit shows the honest not-live state and never invents a contract.
VITE_KIT_TOKEN_CONTRACT=

# NearKit server (server/, the Telegram bot's API). Public URL, not a secret.
# Leave empty when no server runs for this build: the Telegram page then says so.
# Local development: http://localhost:8787
VITE_NEARKIT_API_URL=

# The Telegram bot's username (public), e.g. NearKitBot. Leave empty without a bot.
# The bot token is a SECRET and never goes here: it lives only in server/.env.local.
VITE_TELEGRAM_BOT=
