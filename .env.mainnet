# Mainnet builds: npm run dev:mainnet (development) and npm run preview:mainnet (production).
# No value here is secret. Value-moving actions stay off; the controlled smoke test turns
# them on only in the git-ignored .env.mainnet.local (see MAINNET_SMOKE_TEST.md).
VITE_NEARKIT_SERVICES=near
VITE_NEAR_NETWORK=mainnet
VITE_ENABLE_MAINNET_EXECUTION=false
# NearKit's production fee account (owner decision, 2026-09-29). It receives 0.40% of each
# trade; Rhea keeps 0.10% of the 0.50% fee. Setting it enables nothing: execution stays off.
VITE_NEARKIT_FEE_RECIPIENT=nearkitfee.near
