.env
.env.*
!.env.example
!.env.signer.example
!.env.demo
!.env.e2e
!.env.mainnet
!.env.bridge-e2e

# Keys and wallet data never belong in this repository.
*.pem
*.key
*.p12
*.keystore
.near-credentials
near-credentials
credentials.json

# Test and review artifacts (screenshots, reports, tool caches)
coverage
playwright-report
test-results
.impeccable/review
.impeccable/*.cache.json

# Vercel CLI project link (per machine)
.vercel

# Telegram bot server state (SQLite database, local only)
server/data
