# NearKit signer service. Copy to server/.env.signer.local (git-ignored) and fill in.
# Variables set in the host environment win over this file.
#
# The signer is the only process that opens NearKit wallet keys. It must NOT have the
# Telegram bot token, the app's database URL or NEARKIT_WALLET_KEK. Run it on its own
# host or container, reachable only from the app (private network), never from the web.

# "testnet" or "mainnet". Required: never assumed.
NEAR_NETWORK=testnet

# Mainnet only: the owner's go-live switch. Leave unset until the mainnet ceremony.
# NEARKIT_MAINNET_CUSTODY=enabled

# SECRET. Shared with the app (npm run signer:auth-key writes the same random key to
# server/.env.wallet.local and server/.env.signer.local). 32 random bytes, base64.
NEARKIT_SIGNER_AUTH_KEY=

# Key-encryption key. Mainnet: an AWS KMS key ARN (a symmetric key; the signer's IAM
# role may kms:Encrypt and kms:Decrypt on it, nothing else). Aliases are not accepted.
NEARKIT_KMS_KEY_ARN=
# Rotation: the old key ARNs, comma-separated, until `npm run signer:admin -- reseal --apply`.
NEARKIT_KMS_PREVIOUS_KEY_ARNS=
# Testnet only: SECRET 32 random bytes, base64, instead of a KMS key (refused on mainnet).
NEARKIT_SIGNER_KEK=
NEARKIT_SIGNER_KEK_PREVIOUS=

# SECRET. The signer's own PostgreSQL database (its own credentials; required on mainnet).
NEARKIT_SIGNER_DATABASE_URL=
# Testnet only, without PostgreSQL: a SQLite file (default server/data/signer-<network>.sqlite).
NEARKIT_SIGNER_DB_PATH=

# The NearKit web app's host: every owner signature must name it (NEP-413 recipient).
NEARKIT_SIGNER_RECIPIENT=nearkit.vercel.app

# Mainnet: exactly nearkitfee.near (the production fee account). Testnet: empty.
NEARKIT_FEE_RECIPIENT=

# RPC providers the signer asks itself (comma-separated), and how many must agree.
# Mainnet: at least two, quorum 2 or more. Default: NearKit's providers for the network.
NEARKIT_SIGNER_RPC_URLS=
NEARKIT_SIGNER_RPC_QUORUM=

# The most a swap's minimum may sit below the signer's own Rhea quote, in percent.
# Default 50 (the product's maximum slippage). Lower is safer against a compromised app.
NEARKIT_SIGNER_MAX_SLIPPAGE_PCT=

# Where it listens. Mainnet: TLS (cert and key paths) unless the host is 127.0.0.1.
NEARKIT_SIGNER_HOST=127.0.0.1
NEARKIT_SIGNER_PORT=8790
NEARKIT_SIGNER_TLS_CERT=
NEARKIT_SIGNER_TLS_KEY=

# Kill switch on the host: "true", or a file path whose existence pauses the signer.
NEARKIT_SIGNER_PAUSED=false
NEARKIT_SIGNER_PAUSE_FILE=

# debug | info | warn | error
LOG_LEVEL=info
