# NearKit server (Telegram bot + API). Copy to server/.env.local (git-ignored) and fill in.
# Variables set in the host environment win over this file.

# SECRET. From @BotFather. Never commit it, paste it anywhere, or log it.
# Empty: the API runs without the bot.
TELEGRAM_BOT_TOKEN=
# The bot that token must belong to (e.g. NearKitBot). Set it in production: a token of
# another (test) bot then stops the server at start.
TELEGRAM_BOT_USERNAME=

# Optional: a self-hosted telegram-bot-api server instead of api.telegram.org.
TELEGRAM_API_URL=

# "testnet" (default) or "mainnet". Must match the NearKit web app in NEARKIT_WEB_URL.
NEAR_NETWORK=testnet

# Optional RPC override, comma-separated (defaults: FastNEAR, Intear, dRPC).
NEAR_RPC_URL=

# NearKit web app the bot sends users to (account linking, trade review and signing).
# Its host is the NEP-413 "recipient" a link signature must name.
NEARKIT_WEB_URL=https://nearkits.com

# Account that receives the NearKit app fee (public, not a secret). The fee is 0.50%
# (NEARKIT_FEE in src/lib/fees.ts). On mainnet it must be exactly nearkitfee.near, the
# production fee account: any other refuses to start (a test account anywhere, too).
# Leave it empty on testnet: no fee is charged there.
NEARKIT_FEE_RECIPIENT=

# $KIT contract once launched; empty until then.
KIT_TOKEN_CONTRACT=

# API the web app calls. Bind to 127.0.0.1 locally; behind a reverse proxy in production.
NEARKIT_API_HOST=127.0.0.1
NEARKIT_API_PORT=8787
# Public URL of this API (what the web app's VITE_NEARKIT_API_URL points to).
NEARKIT_API_PUBLIC_URL=
# Browser origins allowed to call the API. Default: the origin of NEARKIT_WEB_URL.
NEARKIT_API_ALLOWED_ORIGINS=

# SQLite database file. Default: server/data/nearkit-<network>.sqlite (git-ignored).
NEARKIT_DB_PATH=
# SECRET. PostgreSQL instead of SQLite (production; required for mainnet custody and for
# more than one instance). Never shown in logs. postgres://user:password@host:5432/db
NEARKIT_DATABASE_URL=

# SECRET. Key-encryption key for NearKit wallets when the signer runs in this process
# (32 random bytes, base64). Testnet only: refused on mainnet (keys live with the signer
# service and its KMS there). Without it, or the signer service, NearKit wallets are off.
# Locally, `npm run server:wallet-key` writes one to server/.env.wallet.local (git-ignored)
# without printing it. On a host, set it as a secret variable, never on the data volume.
# Losing it makes every wallet key unreadable (a wallet's backup key still works).
NEARKIT_WALLET_KEK=

# NearKit wallets through the separate signer service (production): its https:// URL
# on the private network, and the SECRET request-signing key it shares with the app
# (npm run signer:auth-key). Setting these takes precedence over NEARKIT_WALLET_KEK.
NEARKIT_SIGNER_URL=
NEARKIT_SIGNER_AUTH_KEY=
# When the signer makes its own certificate (NEARKIT_SIGNER_TLS_DIR), the pin it logs at
# start: base64 of that certificate. Public. The app then trusts that certificate only.
NEARKIT_SIGNER_TLS_PIN=

# Mainnet custody (NearKit wallets on mainnet): off until the owner turns it on at
# go-live with "enabled". With it on, the server refuses to start without the signer
# service over https, PostgreSQL, the production fee account and the https web app.
NEARKIT_MAINNET_CUSTODY=off

# Kill switches the host holds paused, for a host without a shell: "trading",
# "withdrawals" or both (comma-separated). Nothing in the database lifts them; removing
# this and restarting does. `npm run ops` handles them where there is a shell.
NEARKIT_OPS_PAUSED=

# Buybot: posts buys of tokens group admins choose (/buybot). Read-only.
BUYBOT_ENABLED=true
# "app" (default): this process follows the chain and posts alerts. "separate": this
# process only handles the groups' /buybot settings and `npm run buybot` posts, so a
# buybot failure never touches trading (recommended in production).
BUYBOT_RUNNER=app
# Separate buybot process only: a port for its secret-free /health (optional).
BUYBOT_HEALTH_PORT=
# "mainnet" (default) or "testnet": may differ from NEAR_NETWORK, since it only reads.
BUYBOT_NETWORK=mainnet
# Optional RPC override for the buybot's network (comma-separated).
BUYBOT_RPC_URL=
# FastNEAR transaction index for that network (default tx.main / tx.test.fastnear.com).
BUYBOT_DATA_URL=

# debug | info | warn | error
LOG_LEVEL=info
