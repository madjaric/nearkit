# NearKit server (Telegram bot + API). Copy to server/.env.local (git-ignored) and fill in.
# Variables set in the host environment win over this file.

# SECRET. From @BotFather. Never commit it, paste it anywhere, or log it.
# Empty: the API runs without the bot.
TELEGRAM_BOT_TOKEN=

# Optional: a self-hosted telegram-bot-api server instead of api.telegram.org.
TELEGRAM_API_URL=

# "testnet" (default) or "mainnet". Must match the NearKit web app in NEARKIT_WEB_URL.
NEAR_NETWORK=testnet

# Optional RPC override, comma-separated (defaults: FastNEAR, Intear, dRPC).
NEAR_RPC_URL=

# NearKit web app the bot sends users to (account linking, trade review and signing).
# Its host is the NEP-413 "recipient" a link signature must name.
NEARKIT_WEB_URL=https://nearkit.vercel.app

# Account that receives the NearKit app fee on mainnet quotes (public, not a secret).
# Leave empty until the final fee account is decided: mainnet quotes then say trading
# is blocked, exactly like the web app. Must belong to NEAR_NETWORK.
NEARKIT_FEE_RECIPIENT=

# $KIT contract once launched; empty until then.
KIT_TOKEN_CONTRACT=

# API the web app calls. Bind to 127.0.0.1 locally; behind a reverse proxy in production.
NEARKIT_API_HOST=127.0.0.1
NEARKIT_API_PORT=8787
# Public URL of this API (what the web app's VITE_NEARKIT_API_URL points to).
NEARKIT_API_PUBLIC_URL=
# Browser origins allowed to call the API. Default: the origin of NEARKIT_WEB_URL.
NEARKIT_API_ALLOWED_ORIGINS=

# SQLite database file. Default: server/data/nearkit-<network>.sqlite (git-ignored).
NEARKIT_DB_PATH=

# SECRET. Key-encryption key for NearKit trading wallets (32 random bytes, base64).
# Testnet only: trading wallets are off on mainnet in this build. Without it they are off too.
# Locally, `npm run server:wallet-key` writes one to server/.env.wallet.local (git-ignored)
# without printing it. On a host, set it as a secret variable, never on the data volume.
# Losing it makes every wallet key unreadable (a wallet's backup key still works).
NEARKIT_WALLET_KEK=

# Buybot: posts buys of tokens group admins choose (/buybot). Read-only.
BUYBOT_ENABLED=true
# "mainnet" (default) or "testnet": may differ from NEAR_NETWORK, since it only reads.
BUYBOT_NETWORK=mainnet
# Optional RPC override for the buybot's network (comma-separated).
BUYBOT_RPC_URL=
# FastNEAR transaction index for that network (default tx.main / tx.test.fastnear.com).
BUYBOT_DATA_URL=

# debug | info | warn | error
LOG_LEVEL=info
