# NearKit signer on the VPS: /opt/nearkit/signer.env. Nothing here is secret.
NEAR_NETWORK=mainnet
NEARKIT_MAINNET_CUSTODY=enabled
# The key-encryption key in OpenBao transit (the signer's token comes as a file).
NEARKIT_OPENBAO_ADDR=https://openbao:8200
NEARKIT_OPENBAO_TRANSIT_KEY=nearkit-wallets
# OpenBao's certificate (public): base64 of its DER, from data/openbao-tls/openbao.crt.
NEARKIT_OPENBAO_TLS_PIN=
NEARKIT_SIGNER_RECIPIENT=nearkit.vercel.app
# NearKit's bot (public: the digits before ":" in its token, or `id` in the app's startup log).
# The signer checks approvals given in the bot's Mini App with Telegram's own key; without it,
# wallets with no owner wallet can't approve withdrawal addresses, so the app creates none.
NEARKIT_SIGNER_TELEGRAM_BOT_ID=
NEARKIT_FEE_RECIPIENT=nearkitfee.near
NEARKIT_SIGNER_RPC_URLS=https://free.rpc.fastnear.com,https://rpc.intea.rs,https://near.drpc.org
NEARKIT_SIGNER_RPC_QUORUM=2
NEARKIT_SIGNER_HOST=0.0.0.0
NEARKIT_SIGNER_PORT=8790
NEARKIT_SIGNER_TLS_DIR=/data/tls
NEARKIT_SIGNER_PAUSE_FILE=/run/nearkit/signer.paused
# Starts paused; the owner lifts it at go-live (remove, restart).
NEARKIT_SIGNER_PAUSED=true
LOG_LEVEL=info
