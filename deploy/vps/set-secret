#!/usr/bin/env bash
# The owner enters a secret on the server, unseen: nothing is echoed or logged, and it goes
# straight into /opt/nearkit/secrets (owner 1000, mode 400).
#
#   set-secret telegram_bot_token      the bot token from @BotFather
#   set-secret aws_credentials         the signer's KMS access key (ID, then secret)
set -euo pipefail
name="${1:-}"
dir=/opt/nearkit/secrets
case "$name" in
  telegram_bot_token)
    read -rsp "Paste the Telegram bot token (hidden), then Enter: " value; echo
    [[ "$value" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$ ]] || { echo "That does not look like a bot token. Nothing was saved."; exit 1; }
    content="$value"
    ;;
  aws_credentials)
    read -rsp "Paste the access key ID (hidden), then Enter: " id; echo
    read -rsp "Paste the secret access key (hidden), then Enter: " key; echo
    [[ "$id" =~ ^[A-Z0-9]{16,128}$ && ${#key} -ge 30 ]] || { echo "That does not look like an AWS access key. Nothing was saved."; exit 1; }
    content=$(printf '[default]\naws_access_key_id = %s\naws_secret_access_key = %s\n' "$id" "$key")
    unset id key
    ;;
  *)
    echo "usage: set-secret telegram_bot_token | aws_credentials"
    exit 2
    ;;
esac
umask 077
tmp=$(mktemp "$dir/.new.XXXXXX")
printf '%s' "$content" > "$tmp"
unset content value
chown 1000:1000 "$tmp"
chmod 400 "$tmp"
mv -f "$tmp" "$dir/$name"
echo "Saved $name. It was not shown anywhere."
