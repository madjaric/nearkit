#!/usr/bin/env bash
# The owner enters a secret on the server, unseen: nothing is echoed or logged, and it goes
# straight into /opt/nearkit/secrets (owner 1000, mode 400).
#
#   set-secret telegram_bot_token      the bot token from @BotFather
set -euo pipefail
name="${1:-}"
dir=/opt/nearkit/secrets
case "$name" in
  telegram_bot_token)
    read -rsp "Paste the Telegram bot token (hidden), then Enter: " value; echo
    [[ "$value" =~ ^[0-9]{6,12}:[A-Za-z0-9_-]{30,}$ ]] || { echo "That does not look like a bot token. Nothing was saved."; exit 1; }
    content="$value"
    ;;
  *)
    echo "usage: set-secret telegram_bot_token"
    exit 2
    ;;
esac
umask 077
tmp=$(mktemp "$dir/.new.XXXXXX")
printf '%s' "$content" > "$tmp"
unset content value
chown 1000:1000 "$tmp"
chmod 400 "$tmp"
mv -f "$tmp" "$dir/$name"
echo "Saved $name. It was not shown anywhere."
