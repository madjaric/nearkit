# /opt/nearkit/monitor.env: where bin/monitor sends alerts (DEPLOYMENT.md §13). No secret here:
# alerts go through NEARKITS' own bot (its token stays in secrets/), to this chat.
# The owner's Telegram chat id (their numeric user id); without it, alerts only reach the journal.
ALERT_TELEGRAM_CHAT_ID=
# The API host Caddy serves (/health is checked through it, on this machine).
MONITOR_PUBLIC_HOST=srv2021581.hstgr.cloud
# Optional thresholds (defaults shown).
# MONITOR_REALERT_SECONDS=21600
# MONITOR_DIGEST_HOUR_UTC=7
# MONITOR_SIGNER_DENIALS=5
# MONITOR_POLL_ERRORS=5
# MONITOR_APP_ERRORS=20
# MONITOR_FAILED_OPS=5
# MONITOR_BUYBOT_BACKLOG=50
