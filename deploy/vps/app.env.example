# NearKit app (bot + API) on the VPS: /opt/nearkit/app.env. Nothing here is secret; the
# secrets come as files (docker-compose.yml). <API_HOST>: the server's HTTPS host name.
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://free.rpc.fastnear.com,https://rpc.intea.rs,https://near.drpc.org
TELEGRAM_BOT_USERNAME=NearKitBot
NEARKIT_WEB_URL=https://nearkit.vercel.app
NEARKIT_API_HOST=0.0.0.0
NEARKIT_API_PORT=8787
NEARKIT_API_PUBLIC_URL=https://<API_HOST>
NEARKIT_API_ALLOWED_ORIGINS=https://nearkit.vercel.app
# Caddy is the only way in: the client is the last X-Forwarded-For entry (rate limits).
NEARKIT_API_TRUST_PROXY=true
NEARKIT_FEE_RECIPIENT=nearkitfee.near
NEARKIT_SIGNER_URL=https://signer:8790
# The pin the signer logs at its first start (public): `docker compose logs signer`.
NEARKIT_SIGNER_TLS_PIN=
# "off" until the owner's go-live; then "enabled".
NEARKIT_MAINNET_CUSTODY=off
# Kill switches held by the host (restart to apply): trading,withdrawals
NEARKIT_OPS_PAUSED=
BUYBOT_RUNNER=separate
LOG_LEVEL=info
