# /opt/nearkit/backup-offsite.env: where bin/backup-offsite sends the encrypted copies
# (DEPLOYMENT.md §12). No secret here: the deploy key is a root-only file in secrets/, and
# the recipients are age PUBLIC keys.
BACKUP_REMOTE=git@github.com:madjaric/nearkit-backups.git
BACKUP_SSH_KEY=/opt/nearkit/secrets/backup_deploy_key
BACKUP_KNOWN_HOSTS=/opt/nearkit/github_known_hosts
BACKUP_RECIPIENTS=/opt/nearkit/backup-recipients.txt
